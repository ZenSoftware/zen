{
  "name": "@zen/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@zen/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@zen/api:build:development"
          },
          "production": {
            "buildTarget": "@zen/api:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@casl/ability": "~7.0.2",
    "@casl/prisma": "~2.0.2",
    "@graphql-tools/merge": "^9.2.8",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/platform-socket.io": "^12.2.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.2.0",
    "@paljs/plugins": "8.1.0",
    "@prisma/client": "6.1.0",
    "@prisma/internals": "6.1.0",
    "axios": "^1.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.9",
    "express": "5.3.0",
    "graphql": "~16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.7",
    "graphql-upload": "^17.1.0",
    "graphql-ws": "^6.4.1",
    "handlebars": "^4.7.10",
    "hash-wasm": "^4.12.0",
    "helmet": "^8.3.0",
    "nodemailer": "10.0.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "prisma": "6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "socket.io": "4.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0"
  }
}
